# Copiar en el VPS: cp .env.docker.example .env  →  nano .env

# Dominio (sin https://). Debe apuntar por DNS A a la IP del VPS.
ENCUESTA_HOST=miprimercasafsa-sorteo.com

# API / SQL Server (misma BD que Render)
SP_NAME=dbo.encuestaCargaSorteo01
# 2do paso: @telefono, @encuesta, @campo5Valor..@campo8Valor (encuestaActualizaEntrevistaSorteo01)
SP_INTERVIEW_NAME=dbo.encuestaActualizaEntrevistaSorteo01
ENCUESTA_TABLE_NAME=encuesta

# Canal de origen (1=QR | 2=Manual | 3=Instagram | 4=Facebook).
# Ponerlo en "true" SOLO cuando el SP dbo.encuestaCargaSorteo01 declare el parámetro,
# si no SQL Server tira error al ejecutar el SP.
SP_INCLUDE_ORIGEN=true
SP_ORIGEN_PARAM_NAME=origen
DB_HOST=TU_HOST_SQL
DB_PORT=1433
DB_NAME=TU_BASE
DB_USER=TU_USUARIO
DB_PASSWORD=TU_PASSWORD
DB_ENCRYPT=false
DB_TRUST_CERT=true
