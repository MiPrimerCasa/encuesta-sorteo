# API
API_PORT=3001
PORT=3001

# SQL Server — login [dbo].[operadorAccesoCategoria]
# exec dbo.operadorAccesoCategoria @LoginID = 'email', @PasID = 'clave'
SP_LOGIN=dbo.operadorAccesoCategoria
SP_LOGIN_PARAM_USER=LoginID
SP_LOGIN_PARAM_PASS=PasID
# Si el SP usa otros nombres de columna para la regla supervisor/vendedor:
# SP_LOGIN_COL_SUPERVISOR=idSupervisor
# SP_LOGIN_COL_VENDEDOR=idVendedor
# SP_LOGIN_COL_CODIGO=codigoVendedor
# Códigos SORTEO en operadorAccesoCategoria (jun. 2026):
# SP_LOGIN_COL_CODIGO_PROMOTOR=codigoPromotor
# SP_LOGIN_COL_CODIGO_SUPERVISOR=codigoSupervisor

# Listado de encuestas / leads — exec dbo.encuestasMuestraOperador @idVendedor (idOperador del login)
SP_ENCUESTAS=encuestasMuestraOperador
# Panel superadmin — exec dbo.encuestasMuestra (todas las encuestas, sin filtro operador)
SP_ENCUESTAS_ADMIN=encuestasMuestra
SP_ENCUESTAS_PARAM_ID=idVendedor

# Seguimiento CRM → dbo.SP_RegistrarSeguimientoLead (INSERT en registrarSeguimientoLead)
# Seguimiento — solo vía SP (sin GRANT SELECT en tabla). Ver sql/grants-mpcsp-leads.sql
SP_SEGUIMIENTO=dbo.SP_RegistrarSeguimientoLead
# SP_SEGUIMIENTO_HISTORIAL=dbo.SP_HistorialSeguimientoLead
# SP_SEGUIMIENTO_ULTIMOS=dbo.SP_UltimoSeguimientoOperador
# Panel superadmin — historial bulk y últimos globales (sql/SP_HistorialSeguimientoAdmin.sql)
# SP_SEGUIMIENTO_ADMIN_HISTORIAL=dbo.SP_HistorialSeguimientoAdmin
# SP_SEGUIMIENTO_ULTIMOS_GLOBAL=dbo.SP_UltimoSeguimientoGlobal
# SEGUIMIENTO_SOLO_SP=true
# Lectura (auto si SP_SEGUIMIENTO está definido; SP_SEGUIMIENTO_*=false fuerza SELECT directo)
SP_SEGUIMIENTO_HISTORIAL=dbo.SP_HistorialSeguimientoLead
SP_SEGUIMIENTO_ULTIMOS=dbo.SP_UltimoSeguimientoOperador
SEGUIMIENTO_TABLE=registrarSeguimientoLead

# Carga manual CRM → dbo.encuestaCargaSorteo01
SP_CARGA_ENCUESTA=encuestaCargaSorteo01
# Modificar lead manual existente (teléfono / campos) → dbo.encuestaSorteo01Update
SP_MODIFICAR_ENCUESTA=encuestaSorteo01Update
# Debe coincidir con ?Encuesta= de la landing (SORTEO01 → sorteo01 salvo ENCUESTA_CARGA_ID_EXACT=true)
ENCUESTA_CARGA_ID=sorteo01
# @origen char(1): 1=QR 2=Manual/App (upsert si teléfono ya existe en la encuesta)
SP_CARGA_INCLUDE_ORIGEN=true
# Referidos del seguimiento → alta automática (encuesta + vínculo lead_referido)
REFERIDOS_AUTO_CARGA=true
# SP que crea fila en encuesta + dbo.lead_referido (sql/lead_referido-tabla-sp.sql)
SP_REGISTRAR_REFERIDO=SP_RegistrarReferidoLead
SP_OBTENER_META_REFERIDO=SP_ObtenerMetaReferidosLead
# false = solo encuestaCargaSorteo01 sin tabla de vínculos
# REFERIDOS_USE_SP=false
# @origen para referidos (default 2 = manual/app, upsert si ya existe)
# SP_CARGA_ORIGEN_REFERIDO=2
# DEBUG_CARGA_ENCUESTA=1
# Respaldo si el SP no trae dirección de sucursal en el listado
# SUPERVISOR_SUCURSAL_DIRECCION=FOTHERINGHAM 1089

# Links redes sociales — exec dbo.rptLinkQRenRedesSociales en STRSYSTEM (DB_NAME)
SP_LINKS_REDES=dbo.rptLinkQRenRedesSociales
# LINKS_REDES_SOURCE=sql   (default) | json (solo planilla links-redes.json)
# Si el SP filtra por código: SP_LINKS_REDES_PARAM_CODIGO=Codigo
# Teléfono wa.me si el SP no trae URL completa:
# WA_PHONE=5493705229067

# Superadmin — emails/login IDs (coma) con acceso al panel global
# SUPERADMIN_LOGIN_IDS=admin@empresa.com
# IDs operador SQL de supervisores (idOperador = @idVendedor). Opcional nombre: id:Nombre
# ADMIN_SUPERVISOR_IDS=132:Norma M,145:Adela Alcaraz
# Supervisores o promotores con acceso al "Panel global" (superadmin dashboard).
# No requiere cambiar el rol en la BD. Comma-separated login IDs:
# PANEL_GLOBAL_LOGIN_IDS=gerente@empresa.com,director@empresa.com

# Grabaciones diarias de promotores (grupo obligado)
# Kill switch: dejar en false hasta activar en producción
# GRABACIONES_ENABLED=false
# Formato: id|codigoAlias (nombre se resuelve del catálogo de operadores / SP)
# GRABACIONES_PROMOTOR_IDS=132|SORTEO01S21P01,110|SORTEO01S07P01,142|SORTEO01S03P02,139|SORTEO01S01P02,141|SORTEO01S05P01,137|SORTEO01S03P01
# GRABACIONES_DIR=data/grabaciones
# GRABACIONES_MAX_MB=25
# GRABACIONES_MIN_DURATION_SEC=0
# GRABACIONES_MAX_MES=20
# Tope mensual total (promoción + entrevista), no es objetivo de cumplimiento
# GRABACIONES_RETENTION_DAYS=60

# Backup diario de data/ local (SQLite + audios) — 14 archivos rotativos
# DATA_BACKUP_ENABLED=true
# DATA_BACKUP_MAX_FILES=14
# GRABACIONES_CLEANUP_STARTUP_DELAY_MS=120000
# GRABACIONES_CLEANUP_INTERVAL_MS=21600000


# Acortador propio deshabilitado (links vienen desde STRSYSTEM / ingeniero)
# LINKS_ACORTADOR_ENABLED=false
# Links acortados — programador automático (solo si LINKS_ACORTADOR_ENABLED=true)
# LINKS_JOB_ENABLED=false
# LINKS_JOB_INTERVAL_DAYS=7
# LINKS_JOB_STARTUP_DELAY_MS=60000
# LINKS_VERIFY_INTERVAL_DAYS=7
# LINKS_VERIFY_MAX_PER_RUN=1
# LINKS_ACORTAR_PAUSA_MS=1000
# GOOGLE_SHEET_ID=
# GOOGLE_SHEET_NAME=Hoja 1

DB_HOST=190.106.131.63
DB_PORT=1433
DB_NAME=STRSYSTEM
# Base del SP de leads. Usá STRSYSTEM si está ahí (mismo pool que el login).
# Solo mensajeria si el SP vive allí y MPCSP tiene EXECUTE en esa base.
ENCUESTAS_DB_NAME=STRSYSTEM
DB_USER=MPCSP
DB_PASSWORD=MPCSP

DB_ENCRYPT=false
DB_TRUST_CERT=true

# Mapeos de códigos de equipo a IDs de supervisor (ej. S01 -> 23)
# PROMOTOR_EQUIPO_SUPERVISOR_IDS={"S01":"23","S02":"45","S03":"72","S04":"121","S05":"123","S06":"130","S07":"101","S08":"122","S09":"126","S10":"110","S11":"37","S12":"113","S14":"78","S15":"87","S16":"15","S18":"39","S19":"42","S20":"47","S21":"132","S22":"2"}
