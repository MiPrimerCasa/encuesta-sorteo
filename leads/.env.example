# API
API_PORT=3001
PORT=3001

# SQL Server — login [dbo].[operadorAccesoCategoria]
# exec dbo.operadorAccesoCategoria @LoginID = 'email', @PasID = 'clave'
SP_LOGIN=dbo.operadorAccesoCategoria
SP_LOGIN_PARAM_USER=LoginID
SP_LOGIN_PARAM_PASS=PasID
# Si el SP usa otros nombres de columna para la regla supervisor/vendedor:
# SP_LOGIN_COL_SUPERVISOR=idSupervisor
# SP_LOGIN_COL_VENDEDOR=idVendedor
# SP_LOGIN_COL_CODIGO=codigoVendedor

# Listado de encuestas / leads — exec dbo.encuestasMuestraOperador @idVendedor (idOperador del login)
SP_ENCUESTAS=encuestasMuestraOperador
SP_ENCUESTAS_PARAM_ID=idVendedor

# Seguimiento CRM → dbo.SP_RegistrarSeguimientoLead (INSERT en registrarSeguimientoLead)
SP_SEGUIMIENTO=dbo.SP_RegistrarSeguimientoLead
SEGUIMIENTO_TABLE=registrarSeguimientoLead

# Carga manual CRM → dbo.encuestaCargaSorteo01
SP_CARGA_ENCUESTA=encuestaCargaSorteo01
# Debe coincidir con ?Encuesta= de la landing (SORTEO01 → sorteo01 salvo ENCUESTA_CARGA_ID_EXACT=true)
ENCUESTA_CARGA_ID=sorteo01
# @origen: 1=QR 2=Manual 3=Instagram 4=Facebook
SP_CARGA_INCLUDE_ORIGEN=true
# DEBUG_CARGA_ENCUESTA=1
# Respaldo si el SP no trae dirección de sucursal en el listado
# SUPERVISOR_SUCURSAL_DIRECCION=FOTHERINGHAM 1089

DB_HOST=190.106.131.63
DB_PORT=1433
DB_NAME=STRSYSTEM
# Base del SP de leads. Usá STRSYSTEM si está ahí (mismo pool que el login).
# Solo mensajeria si el SP vive allí y MPCSP tiene EXECUTE en esa base.
ENCUESTAS_DB_NAME=STRSYSTEM
DB_USER=MPCSP
DB_PASSWORD=MPCSP

DB_ENCRYPT=false
DB_TRUST_CERT=true
