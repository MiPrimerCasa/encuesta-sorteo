# Copiar en el VPS como /opt/seguimiento-leads/.env (chmod 600). NO commitear.

NODE_ENV=production
PORT=3001

# Zona horaria del contenedor (informe «Mes», grabaciones, backups). Default: Argentina.
TZ=America/Argentina/Buenos_Aires

# Dominio público (debe coincidir con DNS A → IP del VPS y labels Traefik)
LEADS_HOST=leads.srv955546.hstgr.cloud
LEADS_PUBLIC_HOST=https://leads.srv955546.hstgr.cloud
# Traefik: dominio y red (deploy-vps-docker.sh detecta la red si no se define)
LEADS_TRAEFIK_HOST=www.miprimercasafsa-sorteo.com
# TRAEFIK_DOCKER_NETWORK=root_default
# Build del front: /leads/ en miprimercasafsa-sorteo.com/leads | / en subdominio leads.*
LEADS_VITE_BASE=/leads/

# Carga manual (encuestaCargaSorteo01)
SP_CARGA_ENCUESTA=encuestaCargaSorteo01
# Modificar lead manual (encuestaSorteo01Update)
SP_MODIFICAR_ENCUESTA=encuestaSorteo01Update
SP_DUPLICAR_ENCUESTA=encuestaCargaSorteo01AddVendedor
# Panel superadmin (RF-35) — login(s) con rol superadmin (email o LoginID, minúsculas OK)
SUPERADMIN_LOGIN_IDS=superadmin@gmail.com
# Login IDs de supervisores o promotores con acceso al Panel global (superadmin dashboard)
PANEL_GLOBAL_LOGIN_IDS=superadmin@gmail.com,supervisor@gmail.com
# IDs operador SQL de supervisores (para leer seguimiento sin GRANT SELECT en tabla)
ADMIN_SUPERVISOR_IDS=132:Norma M,145:Adela Alcaraz
# Landing: ?Encuesta=SORTEO01 → en SP suele ser sorteo01 (misma campaña que el QR)
ENCUESTA_CARGA_ID=sorteo01
SP_CARGA_INCLUDE_ORIGEN=true
REFERIDOS_AUTO_CARGA=true
SP_REGISTRAR_REFERIDO=SP_RegistrarReferidoLead

# Links acortador — deshabilitado por defecto (links directos desde SP)
# LINKS_ACORTADOR_ENABLED=false

# Grabaciones diarias (piloto: activar con GRABACIONES_ENABLED=true)
GRABACIONES_ENABLED=true
GRABACIONES_PROMOTOR_IDS=132|SORTEO01S21P01,110|SORTEO01S07P01,142|SORTEO01S03P02,139|SORTEO01S01P02,141|SORTEO01S05P01,137|SORTEO01S03P01
GRABACIONES_DIR=data/grabaciones
GRABACIONES_MAX_MB=25

# Fotos de cierre Plan Inversión Joven (DNI, anexo, transferencia).
# Quedan en el volumen Docker ./data → data/cierres-pij/{leadId}/...
CIERRES_PIJ_DIR=data/cierres-pij
CIERRES_PIJ_MAX_MB=8

# SOAP sistema integral PIJ (altaModificaPlanJoven). Desactivado por defecto.
# Activar solo cuando el ingeniero confirme ambiente / pruebas.
# Bloqueo PIJ → idVentaIntegral (default: SP directo en STRSYSTEM)
PIJ_BLOQUEO_ENABLED=false
PIJ_BLOQUEO_MODE=sp
# PIJ_BLOQUEO_SP=dbo.loteVentaBloqueoVendedorPIJ
# Legacy / fallback SOAP (si PIJ_BLOQUEO_MODE=soap; también acepta PIJ_SOAP_ENABLED como master):
PIJ_SOAP_ENABLED=false
PIJ_SOAP_URL=https://www.miprimercasa.ar/pij/pij.asmx
PIJ_SOAP_NAMESPACE=http://190.106.131.63/MPC/PIJ
PIJ_SOAP_TIMEOUT_MS=60000
# Logs de fallos SOAP (request redactado + response) → data/pij-soap-logs/
# PIJ_SOAP_LOG_DIR=data/pij-soap-logs
# PIJ_SOAP_LOG_OK=false

# MySQL "nube" caja de sucursal (red Docker interna; NO publicar 3306)
CAJA_MYSQL_ENABLED=false
CAJA_MYSQL_HOST=mysql-caja
CAJA_MYSQL_PORT=3306
CAJA_MYSQL_DB=caja_pij
CAJA_MYSQL_USER=crm_caja
CAJA_MYSQL_PASSWORD=
# Tokens por código ERP (01 Centro, 02 Sur, 03 Norte). Auth Bearer en /api/caja/*
CAJA_SYNC_TOKENS={"01":"cambia-este-token-largo"}
CAJA_ERP_SUCURSAL_MAP={"S21":"01"}
CAJA_DEFAULT_SUCURSAL=01

# Piloto local (no usar en VPS): CRM → Electron POST :3847
# ERP_CAJA_INGEST_URL=http://127.0.0.1:3847
# ERP_CAJA_API_KEY=dev-crm-key-local

GRABACIONES_MIN_DURATION_SEC=0
GRABACIONES_MAX_MES=20
# Tope mensual total (promoción + entrevista), no es cuota de cumplimiento
GRABACIONES_RETENTION_DAYS=60
GRABACIONES_RETENTION_RECHAZADO_PROMOCION_DAYS=7
GRABACIONES_RETENTION_RECHAZADO_ENTREVISTA_DAYS=30
GRABACIONES_CLEANUP_STARTUP_DELAY_MS=120000
GRABACIONES_CLEANUP_INTERVAL_MS=21600000

# Backup diario de data/ (SQLite + grabaciones + fotos PIJ) → data/backups/data-local-AAAA-MM-DD.tar.gz
DATA_BACKUP_ENABLED=true
DATA_BACKUP_MAX_FILES=14
DATA_BACKUP_STARTUP_DELAY_MS=180000
DATA_BACKUP_INTERVAL_MS=21600000

# SQL Server (mismo servidor que usa la landing / STRSYSTEM)
DB_HOST=
DB_PORT=1433
DB_NAME=STRSYSTEM
ENCUESTAS_DB_NAME=STRSYSTEM
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Login operadores
SP_LOGIN=dbo.operadorAccesoCategoria
SP_LOGIN_PARAM_USER=LoginID
SP_LOGIN_PARAM_PASS=PasID
# SP_LOGIN_COL_SUPERVISOR=idSupervisor
# SP_LOGIN_COL_VENDEDOR=idVendedor

# Encuestas / leads
SP_ENCUESTAS=encuestasMuestraOperador
SP_ENCUESTAS_PARAM_ID=idVendedor
SP_ENCUESTAS_ADMIN=encuestasMuestra

# Seguimiento CRM
SP_SEGUIMIENTO=dbo.SP_RegistrarSeguimientoLead
SP_SEGUIMIENTO_HISTORIAL=dbo.SP_HistorialSeguimientoLead
SP_SEGUIMIENTO_ULTIMOS=dbo.SP_UltimoSeguimientoOperador
SP_SEGUIMIENTO_ADMIN_HISTORIAL=dbo.SP_HistorialSeguimientoAdmin
SP_SEGUIMIENTO_ULTIMOS_GLOBAL=dbo.SP_UltimoSeguimientoGlobal
SEGUIMIENTO_TABLE=registrarSeguimientoLead
SP_LINKS_REDES=dbo.rptLinkQRenRedesSociales
