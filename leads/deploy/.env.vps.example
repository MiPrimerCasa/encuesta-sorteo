# Copiar en el VPS: cp leads/deploy/.env.vps.example leads/.env  (chmod 600)

NODE_ENV=production
PORT=3001
BASE_PATH=/leads

# URL pública (mismo dominio que la encuesta)
LEADS_PUBLIC_HOST=https://www.miprimercasafsa-sorteo.com/leads
# Host para smoke test Traefik (sin path)
LEADS_SMOKE_HOST=www.miprimercasafsa-sorteo.com

# SQL Server (STRSYSTEM — mismas credenciales que operadores en producción)
DB_HOST=
DB_PORT=1433
DB_NAME=STRSYSTEM
ENCUESTAS_DB_NAME=STRSYSTEM
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_CERT=true

SP_LOGIN=dbo.operadorAccesoCategoria
SP_LOGIN_PARAM_USER=LoginID
SP_LOGIN_PARAM_PASS=PasID

SP_ENCUESTAS=encuestasMuestraOperador
SP_ENCUESTAS_PARAM_ID=idVendedor

SP_SEGUIMIENTO=dbo.SP_RegistrarSeguimientoLead
