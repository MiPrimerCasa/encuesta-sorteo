# Copiar en el VPS como /opt/seguimiento-leads/.env (chmod 600). NO commitear.

NODE_ENV=production
PORT=3001

# Dominio público (debe coincidir con DNS A → IP del VPS y labels Traefik)
LEADS_HOST=leads.srv955546.hstgr.cloud
LEADS_PUBLIC_HOST=https://leads.srv955546.hstgr.cloud
# Traefik: dominio y red (deploy-vps-docker.sh detecta la red si no se define)
LEADS_TRAEFIK_HOST=www.miprimercasafsa-sorteo.com
# TRAEFIK_DOCKER_NETWORK=root_default
# Build del front: /leads/ en miprimercasafsa-sorteo.com/leads | / en subdominio leads.*
LEADS_VITE_BASE=/leads/

# Carga manual (encuestaCargaSorteo01)
SP_CARGA_ENCUESTA=encuestaCargaSorteo01
# Modificar lead manual (encuestaSorteo01Update)
SP_MODIFICAR_ENCUESTA=encuestaSorteo01Update
# Panel superadmin (RF-35) — login(s) con rol superadmin (email o LoginID, minúsculas OK)
SUPERADMIN_LOGIN_IDS=superadmin@gmail.com
# IDs operador SQL de supervisores (para leer seguimiento sin GRANT SELECT en tabla)
ADMIN_SUPERVISOR_IDS=132:Norma M,145:Adela Alcaraz
# Landing: ?Encuesta=SORTEO01 → en SP suele ser sorteo01 (misma campaña que el QR)
ENCUESTA_CARGA_ID=sorteo01
SP_CARGA_INCLUDE_ORIGEN=true
REFERIDOS_AUTO_CARGA=true
SP_REGISTRAR_REFERIDO=SP_RegistrarReferidoLead

# SQL Server (mismo servidor que usa la landing / STRSYSTEM)
DB_HOST=
DB_PORT=1433
DB_NAME=STRSYSTEM
ENCUESTAS_DB_NAME=STRSYSTEM
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Login operadores
SP_LOGIN=dbo.operadorAccesoCategoria
SP_LOGIN_PARAM_USER=LoginID
SP_LOGIN_PARAM_PASS=PasID
# SP_LOGIN_COL_SUPERVISOR=idSupervisor
# SP_LOGIN_COL_VENDEDOR=idVendedor

# Encuestas / leads
SP_ENCUESTAS=encuestasMuestraOperador
SP_ENCUESTAS_PARAM_ID=idVendedor
SP_ENCUESTAS_ADMIN=encuestasMuestra

# Seguimiento CRM
SP_SEGUIMIENTO=dbo.SP_RegistrarSeguimientoLead
SP_SEGUIMIENTO_HISTORIAL=dbo.SP_HistorialSeguimientoLead
SP_SEGUIMIENTO_ULTIMOS=dbo.SP_UltimoSeguimientoOperador
SP_SEGUIMIENTO_ADMIN_HISTORIAL=dbo.SP_HistorialSeguimientoAdmin
SP_SEGUIMIENTO_ULTIMOS_GLOBAL=dbo.SP_UltimoSeguimientoGlobal
SEGUIMIENTO_TABLE=registrarSeguimientoLead
SP_LINKS_REDES=dbo.rptLinkQRenRedesSociales
