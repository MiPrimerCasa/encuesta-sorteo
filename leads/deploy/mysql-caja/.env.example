# Copiar como /opt/mysql-caja/.env en el VPS (chmod 600). NO commitear el real.

# Contraseña root del contenedor MySQL (uso administrativo)
MYSQL_ROOT_PASSWORD=cambia-root-muy-fuerte

# Base y usuario que usa el CRM (mysql2) para publicar cierres
CAJA_MYSQL_DB=caja_pij
CAJA_MYSQL_USER=crm_caja
CAJA_MYSQL_PASSWORD=cambia-pass-crm-fuerte

# Zona horaria del contenedor
TZ=America/Argentina/Buenos_Aires
