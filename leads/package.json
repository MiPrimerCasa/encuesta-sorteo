{
  "name": "seguimiento-leads",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev:api\" \"vite\"",
    "dev:web": "vite",
    "demo": "vite --mode demo",
    "dev:api": "node --env-file=src/.env server/index.js",
    "desarrollo": "npm run dev",
    "desarrollo:api": "npm run dev:api",
    "build": "tsc && vite build",
    "compilar": "tsc && vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "start:api": "node server/index.js",
    "iniciar:api": "node server/index.js",
    "inspect:login": "node scripts/inspect-login-sp.js",
    "inspect:leads": "node scripts/inspect-leads-sp.js",
    "deploy:vps": "bash scripts/deploy-vps-remote.sh"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "date-fns": "^4.3.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "mssql": "^12.5.2",
    "react": "^19.1.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.3",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^10.0.0",
    "tailwindcss": "^4.1.8",
    "typescript": "~5.8.3",
    "vite": "^7.0.0"
  }
}
